# ===========================================================================
# conf.d/nru/git.zsh — the "pull nixos-config" step of nru
#
# _nru_git_bar pulls the flake repo ($NIXOS_CONFIG) fast-forward only and turns
# each failure into a named message plus, where something can be done about
# it, a one-key menu (_nru_menu). The helpers below it each handle one failure.
# nru (nru.zsh) calls it as its first step; it is not meant to be run directly.
# The step is on while that call is in nru.zsh; remove the call to turn it off.
# ===========================================================================

# ---------------------------------------------------------------------------
# _nru_git_bar — pull the latest nixos-config, fast-forward only.
# Takes no arguments; reads $NIXOS_CONFIG (repo path) and $_NRU_CACHE (log
# goes to git.log). Returns 0 to carry on with the update, 1 to abort nru.
# Sets _NRU_OFFLINE=1 when the user chooses to rebuild offline; later steps
# check it and skip their network work.
#
# Command used: git -C "$cfg" pull --ff-only
#   -C DIR       run as if git was started in DIR
#   --ff-only    update only if the pull is a fast-forward; refuses to merge
#                or rebase. Alternatives: --rebase (replay local commits on
#                top, used by the diverged menu), --no-rebase (merge).
#
# What a failure leads to, decided from the text git printed:
#   "would be overwritten by"                    → _nru_git_local_changes
#   "Not possible to fast-forward", "diverging"  → _nru_git_diverged
#   "Permission denied (publickey)", "Host key verification failed"
#                                                → SSH named; skip or quit
#   "Could not resolve", "Network is unreachable", "Connection timed out",
#   "Connection refused", "Temporary failure in name resolution"
#                                                → offline; rebuild local config anyway? (Y/n)
#   anything else                                → git's output is printed, nru aborts
# ---------------------------------------------------------------------------
_nru_git_bar() {
  local cfg=$NIXOS_CONFIG log="$_NRU_CACHE/git.log" before after n out
  _NRU_OFFLINE=""

  # A local edit to flake.lock would block the pull, and the lock is either
  # regenerated by nru (lock-writer host) or taken from the pull (every other
  # host), so a local change to it is never worth keeping. Reset it to HEAD
  # and say so.
  #   git diff --quiet HEAD -- flake.lock    exit 1 when the file differs from HEAD
  #   git restore --staged --worktree FILE   reset both the index and the working copy of FILE to HEAD
  if ! git -C "$cfg" diff --quiet HEAD -- flake.lock 2>/dev/null; then
    printf "  %s↺  discarded local flake.lock changes (nru regenerates it)%s\n" "$_C_MUTED" "$_C_OFF" >/dev/tty
    git -C "$cfg" restore --staged --worktree flake.lock 2>/dev/null
  fi

  # Compare the short HEAD hash before and after to report how many commits
  # arrived (git rev-list --count A..B = commits reachable from B but not A).
  before=$(git -C "$cfg" rev-parse --short HEAD)
  if _nru_spin "$_NRU_GH" "Nixos-Config" "pulling" "$log" git -C "$cfg" pull --ff-only; then
    after=$(git -C "$cfg" rev-parse --short HEAD)
    if [[ $before == "$after" ]]; then
      _nru_quiet "$_NRU_GH" "Nixos-Config" "up to date"
    else
      n=$(git -C "$cfg" rev-list --count "$before..$after")
      _nru_ok "$_NRU_GH" "Nixos-Config" "$n commit${${n:#1}:+s}  $before → $after"
    fi
    return 0
  fi

  out=$(<"$log")
  case $out in
    *"would be overwritten by"*)
      _nru_git_local_changes; return ;;
    *"Not possible to fast-forward"*|*"diverging branches"*)
      _nru_git_diverged; return ;;
    *"Permission denied (publickey)"*|*"Host key verification failed"*)
      _nru_row "$_NRU_GH" "Nixos-Config" "✗ SSH auth failed · check your ~/.ssh key is added to GitHub"
      _nru_git_skip_or_quit; return ;;
    *"Could not resolve"*|*"Network is unreachable"*|*"Connection timed out"*|*"Connection refused"*|*"Temporary failure in name resolution"*)
      _nru_row "$_NRU_GH" "Nixos-Config" "⚠ offline"
      [[ $(_nru_menu "⚠" "Offline · rebuild local config anyway?" "Y:yes" "n:no") == y ]] || return 1
      _NRU_OFFLINE=1; echo ""; return 0 ;;
  esac

  _nru_row "$_NRU_GH" "Nixos-Config" "✗ pull failed"
  printf '%s\n' "$out"
  return 1
}

# ---------------------------------------------------------------------------
# _nru_git_local_changes — menu for "local changes would be overwritten by the
# pull". No arguments; reads the failed pull's output from git.log.
# Shows each blocking file with its added/removed line counts
# (git diff --numstat HEAD prints "added removed path"), then offers:
#   S  stash & pull    git stash push -u -q -m "nru <date time>"
#                        -u  include untracked files   -q  quiet
#                        -m  name the stash; restore later with `git stash pop`
#   d  discard & pull  tracked files are checked out from HEAD, untracked
#                      ones deleted
#   k  keep, skip pull continue with the local files as they are (returns 0)
#   q  quit            abort nru (returns 1)
# After stash or discard the whole pull is retried (_nru_git_bar).
# ---------------------------------------------------------------------------
_nru_git_local_changes() {
  local cfg=$NIXOS_CONFIG f add del
  local -a files items
  # git lists the blocking files tab-indented under the "would be overwritten"
  # line; awk collects those lines (without the tab) and zsh's (f) flag splits
  # the result at newlines into the array.
  files=(${(f)"$(awk '/would be overwritten by/ {f=1; next} f && /^\t/ {sub(/^\t/, ""); print; next} {f=0}' "$_NRU_CACHE/git.log")"})
  for f in $files; do
    read -r add del _ <<< "$(git -C "$cfg" diff --numstat HEAD -- "$f")"
    items+=("$f${add:+   (+$add −$del)}")
  done
  _nru_row "$_NRU_GH" "Nixos-Config" "✗ local changes block the pull"
  _nru_tree "${items[@]}"

  case $(_nru_menu "⚠" "Local Changes" "S:Stash & pull" "d:discard & pull" "k:keep, skip pull" "q:quit") in
    s) git -C "$cfg" stash push -u -q -m "nru $(date '+%F %H:%M')" || return 1
       printf "  ↓  stashed as \"nru %s\" (git stash pop to restore)\n" "$(date '+%F %H:%M')"
       _nru_git_bar; return ;;
    # `git ls-files --error-unmatch` exits non-zero for a file git does not
    # track, which is how the two cases are told apart.
    d) for f in $files; do
         if git -C "$cfg" ls-files --error-unmatch -- "$f" &>/dev/null; then
           git -C "$cfg" checkout -q HEAD -- "$f"
         else
           rm -f -- "$cfg/$f"
         fi
       done
       _nru_git_bar; return ;;
    k) _nru_row "$_NRU_GH" "Nixos-Config" "⏭ kept local changes, skipped pull"; return 0 ;;
    q) return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# _nru_git_diverged — menu for a local branch and its upstream that both have
# new commits, so a fast-forward is impossible. No arguments.
# Fetches, then counts commits on each side:
#   git rev-list --left-right --count 'HEAD...@{u}'
#   prints "<only local> <only upstream>"  (@{u} = the branch's upstream)
# Offers:
#   R  rebase local onto remote  git pull --rebase; on a conflict the rebase is
#                                aborted, the repo is left unchanged, and the
#                                skip-or-quit menu follows
#   k  keep, skip pull           rebuild the local config as it is (returns 0)
#   q  quit                      abort nru (returns 1)
# ---------------------------------------------------------------------------
_nru_git_diverged() {
  local cfg=$NIXOS_CONFIG ahead behind
  git -C "$cfg" fetch -q 2>/dev/null
  read -r ahead behind <<< "$(git -C "$cfg" rev-list --left-right --count 'HEAD...@{u}')"
  _nru_row "$_NRU_GH" "Nixos-Config" "✗ diverged · $ahead local / $behind remote commits"

  case $(_nru_menu "⚠" "Diverged" "R:Rebase local onto remote" "k:keep, skip pull" "q:quit") in
    r) if _nru_spin "$_NRU_GH" "Nixos-Config" "rebasing" "$_NRU_CACHE/git.log" git -C "$cfg" pull --rebase; then
         _nru_ok "$_NRU_GH" "Nixos-Config" "rebased $ahead local onto $behind remote"
         return 0
       fi
       git -C "$cfg" rebase --abort 2>/dev/null
       _nru_row "$_NRU_GH" "Nixos-Config" "✗ rebase conflict · rebase aborted, repo unchanged"
       _nru_git_skip_or_quit; return ;;
    k) _nru_row "$_NRU_GH" "Nixos-Config" "⏭ skipped pull · rebuilding local config"; return 0 ;;
    q) return 1 ;;
  esac
}

# _nru_git_skip_or_quit — menu after a pull that failed with nothing to fix
# (SSH auth failure, rebase conflict). No arguments.
#   k  keep, skip pull  continue and rebuild the local config (returns 0)
#   Q  quit             abort nru (returns 1; default on Enter)
_nru_git_skip_or_quit() {
  [[ $(_nru_menu "⚠" "Pull Failed" "k:keep, skip pull" "Q:quit") == k ]] || return 1
  _nru_row "$_NRU_GH" "Nixos-Config" "⏭ skipped pull · rebuilding local config"
}

